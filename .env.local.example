# ============================================================
# Thryv RAG – Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================


# ────────────────────────────────────────────────────────────
# LLM (OpenAI)
# Get your key at: https://platform.openai.com/api-keys
# ────────────────────────────────────────────────────────────
LLM_API_KEY=sk-your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048


# ────────────────────────────────────────────────────────────
# Embeddings (OpenAI)
# ────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# -- Ollama alternative (local dev, no API key needed) --
# EMBEDDING_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text


# ────────────────────────────────────────────────────────────
# Chroma Vector Store
# Run locally:  docker run -p 8000:8000 chromadb/chroma
# Production:   Point at a hosted Chroma instance
# ────────────────────────────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=documents


# ────────────────────────────────────────────────────────────
# Rate Limiting
# ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20


# ────────────────────────────────────────────────────────────
# CORS (set to your frontend domain in production)
# ────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=*
