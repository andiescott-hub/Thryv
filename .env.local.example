# ============================================================
# Thryv RAG – Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================


# ────────────────────────────────────────────────────────────
# LLM (OpenAI)
# Get your key at: https://platform.openai.com/api-keys
# ────────────────────────────────────────────────────────────
LLM_API_KEY=sk-your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048


# ────────────────────────────────────────────────────────────
# Embeddings (OpenAI)
# ────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# -- Ollama alternative (local dev, no API key needed) --
# EMBEDDING_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text


# ────────────────────────────────────────────────────────────
# Pinecone Vector Store
# Sign up at https://www.pinecone.io and create a serverless index.
# Use dimension 1536 for text-embedding-3-small, cosine metric.
# ────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=documents


# ────────────────────────────────────────────────────────────
# Rate Limiting
# ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20


# ────────────────────────────────────────────────────────────
# CORS (set to your frontend domain in production)
# ────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=*
