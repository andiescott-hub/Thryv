# ============================================================
# Thryv RAG – Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================


# ────────────────────────────────────────────────────────────
# LLM (kimi-k2.5 via Moonshot AI)
# Get your key at: https://platform.moonshot.cn
# ────────────────────────────────────────────────────────────
LLM_API_KEY=your_moonshot_api_key_here
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.5
LLM_MAX_TOKENS=2048


# ────────────────────────────────────────────────────────────
# Embeddings
# EMBEDDING_PROVIDER: "ollama" (local dev) | "openai" (production)
# ────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama

# -- Ollama settings (used when EMBEDDING_PROVIDER=ollama) --
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# -- OpenAI-compatible settings (used when EMBEDDING_PROVIDER=openai) --
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small


# ────────────────────────────────────────────────────────────
# Chroma Vector Store
# Run locally:  docker run -p 8000:8000 chromadb/chroma
# Production:   Point at a hosted Chroma instance
# ────────────────────────────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=documents


# ────────────────────────────────────────────────────────────
# Rate Limiting
# ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20


# ────────────────────────────────────────────────────────────
# CORS (set to your frontend domain in production)
# ────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=*
